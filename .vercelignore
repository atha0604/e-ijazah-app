# Vercel Ignore - Files not needed for deployment

# Development
.git/
.github/
.vscode/
.idea/

# Electron (not needed for web)
electron-main.js
electron-main-embedded.js
jalankan-electron.bat
*.bat

# Build outputs
dist/
out/
build/

# Logs
*.log
logs/

# OS files
.DS_Store
Thumbs.db

# SQLite (using Supabase PostgreSQL instead)
*.sqlite
*.db

# Temporary
*.tmp
*.temp
temp/

# Documentation (keep only essential)
*.md
!README.md
!VERCEL-DEPLOYMENT.md

# Test files
test/
*.test.js
*.spec.js

# Local environment
.env.local
.env.development

# Node modules (will be installed fresh)
node_modules/
