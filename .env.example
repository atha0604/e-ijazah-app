JWT_SECRET=ubah_ini_dengan_string_acak_panjang
# Optional: override port default 3000
# PORT=3000

# Database Configuration
# ====================
# Untuk Development (lokal): Kosongkan DATABASE_URL (otomatis pakai SQLite)
# Untuk Production (hosting): Isi DATABASE_URL dengan connection string PostgreSQL
#
# Contoh format DATABASE_URL:
# Railway:  postgresql://user:pass@containers-us-west-xxx.railway.app:5432/railway
# Supabase: postgresql://postgres:password@db.xxx.supabase.co:5432/postgres
# Vercel:   postgresql://user:pass@xxx.vercel-storage.com:5432/verceldb
DATABASE_URL=
